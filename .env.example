# ── opšte
AIP_ENV=local
AIP_HTTP_ADDR=:18080
AIP_BASE_URL=http://localhost:18080
AIP_WEB_URL=http://localhost:3000
# URL the browser uses to reach the API; baked into the web image at build time.
AIP_WEB_API_URL=http://localhost:18080
AIP_LOG_LEVEL=debug

# ── baza i queue (ro va u 00_roles.sql)
AIP_DB_DSN=postgres://aip_app:app@localhost:5432/aip?sslmode=disable
AIP_DB_MIGRATOR_DSN=postgres://aip_migrator:migrator@localhost:5432/aip?sslmode=disable
AIP_REDIS_ADDR=localhost:6379

# ── auth
AIP_JWT_KEY=jwt.pem
AIP_ACCESS_TTL=15m
AIP_REFRESH_TTL=720h
AIP_COOKIE_DOMAIN=localhost
AIP_OIDC_GITHUB_CLIENT_ID=
AIP_OIDC_GITHUB_CLIENT_SECRET=
AIP_OIDC_GOOGLE_CLIENT_ID=
AIP_OIDC_GOOGLE_CLIENT_SECRET=
# Generic OIDC (Keycloak/Okta/Azure AD); set all four URLs/credentials to enable.
AIP_OIDC_SSO_NAME=sso
AIP_OIDC_SSO_ISSUER=
# Allow SSO metadata fetch from private/internal IdP addresses (SSRF surface).
AIP_SSO_ALLOW_PRIVATE_METADATA=false
AIP_OIDC_SSO_AUTHORIZE_URL=
AIP_OIDC_SSO_TOKEN_URL=
AIP_OIDC_SSO_USERINFO_URL=
AIP_OIDC_SSO_CLIENT_ID=
AIP_OIDC_SSO_CLIENT_SECRET=

# ── email
AIP_MAILER=mailhog
AIP_SMTP_ADDR=localhost:1025
AIP_MAIL_FROM=no-reply@aip.local

# ── objekti
AIP_DB_ADMIN_DSN=postgres://aip_migrator:migrator@localhost:5432/aip?sslmode=disable
AIP_RETENTION_DAYS=90
AIP_RETENTION_INTERVAL_HOURS=24
AIP_S3_ENDPOINT=http://localhost:9000
AIP_S3_BUCKET=aip-artifacts
AIP_S3_ACCESS_KEY=minio
AIP_S3_SECRET_KEY=minio123
AIP_S3_REGION=eu-central-1

# ── sandbox
AIP_SANDBOX_DRIVER=docker
AIP_SANDBOX_IMAGE=aip/sandbox:go1.25-node22
# The gate command the agent must pass; empty means no test gate.
AIP_TEST_COMMAND=
# Install the locked web dependencies on the worker host before the offline
# sandbox runs (pnpm-lock.yaml at the root or apps/web/).
AIP_DEPS_NPM=true
AIP_PNPM_BIN=pnpm
# OTLP/HTTP collector; empty disables tracing (see deploy/observability/)
AIP_OTEL_ENDPOINT=
# git providers (MVP: one token per provider)
GITHUB_TOKEN=
GITLAB_TOKEN=
# GitHub App (optional; replaces the PAT for PRs/pushes/checks and enables the
# app-wide webhook at /webhooks/github-app; see docs/27-github-app.md)
AIP_GITHUB_APP_ID=
AIP_GITHUB_APP_KEY_PATH=
AIP_GITHUB_APP_INSTALL=
AIP_GITHUB_APP_WEBHOOK_SECRET=
AIP_GITHUB_API_URL=https://api.github.com
AIP_GITHUB_CLONE_BASE=https://github.com
AIP_GITLAB_API_URL=https://gitlab.com
AIP_GITLAB_CLONE_BASE=https://gitlab.com

# command = AIP_AGENT_COMMAND; provider = chat only; tools = chat + read/grep/write/test tools
AIP_AGENT_BACKEND=command
# USD per 1K tokens, used for the usage ledger (0 = cost stays 0)
AIP_PRICE_INPUT_PER_1K=0
AIP_PRICE_OUTPUT_PER_1K=0
# retries for 429/5xx with exponential backoff (1-10)
AIP_LLM_MAX_ATTEMPTS=3
# how many model/tool steps one agent run may take (1-200); multi-file tasks need more
AIP_AGENT_MAX_STEPS=24
# per-tenant limits
AIP_MAX_ACTIVE_RUNS=5
AIP_RATE_LIMIT_PER_MINUTE=600

# trusted command executed inside the sandbox (Claude Code, Codex, ...)
AIP_AGENT_COMMAND=echo 'agent backend not configured' 
# Egress allowlist is not implemented; keep the sandbox offline.
# AIP_SANDBOX_EGRESS_ALLOW=

# ── provideri (dev; u produkciji secrets store)
AIP_PROVIDER_OPENAI_BASE_URL=https://api.openai.com/v1
AIP_PROVIDER_OPENAI_KEY=

# SAML SP (optional). SP key/cert default to an in-memory dev pair.
AIP_SAML_IDP_METADATA=
AIP_SAML_ENTITY_ID=aip-saml
# Run scripts/saml-sp-dev.sh for persistent dev files (mounted at /saml-sp).
AIP_SAML_KEY_FILE=
AIP_SAML_CERT_FILE=
# Comma-separated SAML group values that map to the admin role (owner is never downgraded).
AIP_SAML_ADMIN_GROUPS=
# group:role pairs (admin|member|viewer), e.g. aip-admins:admin,aip-viewers:viewer
AIP_SAML_ROLE_MAP=

# Max concurrent River jobs per worker process (default 4).
AIP_WORKER_MAX_WORKERS=4

# Max concurrent agent runs per organisation (worker gate).
AIP_ORG_MAX_CONCURRENT_RUNS=2

# Plugin image digest allowlist (comma-separated sha256:...); empty allows any digest.
AIP_PLUGIN_ALLOWED_DIGESTS=

# Optional cosign verification for plugin images (requires cosign in the API image).
AIP_COSIGN_BIN=cosign
AIP_COSIGN_IDENTITY=
AIP_COSIGN_ISSUER=
AIP_COSIGN_KEY=

# Data-plane region; empty disables the routing guard.
AIP_REGION=

# AI assistant (optional): the model behind the assistant panel.
# Provider: anthropic (Messages API) or openai (DeepSeek, Ollama, vLLM, LiteLLM).
# DeepSeek: provider=openai, base URL https://api.deepseek.com, model deepseek-chat.
AIP_ASSISTANT_LLM_PROVIDER=anthropic
AIP_ASSISTANT_LLM_BASE_URL=
AIP_ASSISTANT_LLM_API_KEY=
AIP_ASSISTANT_LLM_MODEL=
