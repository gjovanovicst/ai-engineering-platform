{
  "realm": "aip",
  "enabled": true,
  "displayName": "AIP dev",
  "registrationAllowed": false,
  "clients": [
    {
      "clientId": "aip",
      "name": "AIP API",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "aip-dev-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:18080/api/v1/auth/oidc/sso/callback"
      ],
      "webOrigins": [
        "http://localhost:3000"
      ]
    },
    {
      "clientId": "aip-saml",
      "name": "AIP SAML",
      "enabled": true,
      "protocol": "saml",
      "frontchannelLogout": false,
      "redirectUris": [
        "http://localhost:18080/saml/acs"
      ],
      "attributes": {
        "saml.server.signature": "true",
        "saml.client.signature": "false",
        "saml_name_id_format": "email",
        "saml_force_name_id_format": "true",
        "saml.assertion.signature": "true"
      }
    }
  ],
  "users": [
    {
      "username": "demo",
      "enabled": true,
      "email": "demo@acme.io",
      "firstName": "Demo",
      "lastName": "Owner",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "correct horse battery",
          "temporary": false
        }
      ]
    }
  ]
}
